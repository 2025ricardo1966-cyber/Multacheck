# ─── Producción (obligatorio en Vercel → Environment Variables → Production) ───
# URL pública del backend incluyendo el prefijo /api, sin barra final.
# Ejemplo: https://multacheck-api.onrender.com/api
VITE_API_URL=

# Clave pública Stripe (pk_live_… o pk_test_…). Opcional hoy: el checkout
# redirige a Stripe vía URL devuelta por el backend (no usa Stripe.js en el cliente).
# Reservada por si se integra Stripe Elements más adelante.
VITE_STRIPE_PUBLIC_KEY=

# ─── Desarrollo local ───
# El cliente usa /api; Vite proxifica al backend. Por defecto puerto 3000.
# VITE_BACKEND_PORT=3001

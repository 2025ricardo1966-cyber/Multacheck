{
  "name": "multacheck-monorepo-root",
  "private": true,
  "scripts": {
    "dev:backend": "npm run dev --prefix ./backend",
    "dev:frontend": "npm run dev --prefix ./frontend",
    "dev:all": "concurrently -n backend,frontend -c blue,green \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev": "npm run dev:all",
    "smoke:e2e:multacheck": "tsx ./scripts/smoke-e2e-multacheck.mts"
  },
  "devDependencies": {
    "@types/node": "25.6.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "concurrently": "^9.2.1",
    "tsx": "^4.20.6",
    "typescript": "^6.0.3"
  }
}

{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "baseUrl": ".",
    "paths": {
      "@/core/*": ["core/*"]
    }
  },
  "include": [
    "core/**/*.ts",
    "core/**/*.tsx",
    "config/**/*.ts",
    "scripts/**/*.mts",
    "scripts/**/*.mjs"
  ],
  "exclude": ["node_modules", "frontend", "backend"]
}

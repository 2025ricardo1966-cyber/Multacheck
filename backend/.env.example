PORT=3000

# PostgreSQL (ej. docker-compose en la raíz del repo)
# DATABASE_URL="postgresql://multacheck:multacheck@localhost:5432/multacheck?schema=public"
DATABASE_URL=

# Firma JWT (cadena larga aleatoria en producción)
JWT_SECRET=

# Opcional — ej. 8h, 7d (jsonwebtoken)
JWT_EXPIRES_IN=7d

# Producción: origen del frontend (CORS). En desarrollo con proxy puede quedar vacío.
FRONTEND_URL=

# Stripe — https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Price IDs (productos modo recurring) para Pro y Enterprise
STRIPE_PRICE_PRO=
STRIPE_PRICE_ENTERPRISE=

# URL del frontend para redirects post-checkout (también CORS en prod)
# Ej.: http://localhost:5173 en dev con Stripe CLI / tunnels
# FRONTEND_URL=http://localhost:5173

# Seed opcional (npm run db:seed)
# SEED_ADMIN_EMAIL=admin@multacheck.local
# SEED_ADMIN_PASSWORD=changeme

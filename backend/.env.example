# === DATABASE ===
DATABASE_URL=postgresql://user:password@localhost:5432/multacheck

# === AUTH ===
JWT_SECRET=your-super-secret-key-change-this
JWT_EXPIRES_IN=7d

# === STRIPE ===
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PUBLISHABLE_KEY=pk_test_...

# === AI PROVIDER ===
# Opciones: 'javascript' (gratis, default) | 'openai' (requiere API key)
# El pipeline TypeScript se intenta cuando OPENAI_API_KEY está definida (tras `npm run build:ai`).
AI_PROVIDER=javascript
OPENAI_API_KEY=

# === MONITORING (opcional) ===
SENTRY_DSN=
NODE_ENV=development

# === SERVER ===
PORT=3000
# CORS: Express lee FRONTEND_URL (también CLIENT_ORIGIN en algunos flujos de billing/multa).
FRONTEND_URL=http://localhost:5173

# --- Deploy (opcional) ---
# Comando para reinicio tras `npm run deploy` si no usás `pm2 restart multacheck`
# DEPLOY_RESTART_CMD=

# --- Opcional (ver código / Stripe Dashboard) ---
# LISTEN_HOST=127.0.0.1
# STRIPE_DISCHARGE_CURRENCY=usd
# STRIPE_DISCHARGE_UNIT_AMOUNT=1000
# STRIPE_CHECKOUT_LOCALE=es
# STRIPE_PRICE_PRO=
# STRIPE_PRICE_ENTERPRISE=
# APP_MODE=
# ADMIN_DEBUG_SECRET=

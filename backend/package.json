    "test:security-gateway": "node --test tests/securityGateway.test.mjs",
    "test:telemetry": "node --test tests/telemetry.test.mjs",
    "telemetry:replay": "node scripts/telemetry-replay.mjs",
    "chaos:framework": "node scripts/chaos-framework/cli.mjs",
    "scoring:drift-report": "node scripts/scoring-drift-report.mjs",
    "fraud:graph-demo": "node scripts/fraud-graph-demo.mjs",
    "test:pipeline": "tsx src/ai/pipeline.test.ts",
    "build:ai": "shx rm -rf dist/ai && tsc",
    "test:ai": "npm run build:ai && node -e \"import('./src/ai/index.js').then(m => m.analyzeWithAI({ raw: 'test AR transito' })).then(console.log)\""
